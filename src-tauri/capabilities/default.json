{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:allow-set",
    "store:allow-get",
    "http:default",
    "shell:allow-execute",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
